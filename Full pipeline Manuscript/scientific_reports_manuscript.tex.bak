	%==============================================================================
	\section*{Results}
	%==============================================================================
	
	\subsection*{Derivation-Phase Symbolic Compression and Mathematical Breakthroughs}
	
	A central scientific contribution of our Tier 3 analytical engine lies in restructuring the symbolic computational graph of the Euler--Lagrange equations \textbf{offline during the derivation phase}, eliminating the computational bottlenecks of classical symbolic mechanics without resorting to numerical approximations:
	\begin{enumerate}
		\item \textbf{Direct Generalized Momentum Directional Derivative for Coriolis Bias:} In classical Lagrangian robot mechanics \cite{craig2005introduction, spong2020robot, ihab2026urdf2dt}, the Coriolis and centrifugal matrix $\bm{C}(\bm{q},\dot{\bm{q}})$ is constructed via the $n^3$ Christoffel symbols of the first kind:
		\begin{equation}
			c_{ijk}(\bm{q}) = \frac{1}{2}\left( \frac{\partial M_{ij}(\bm{q})}{\partial q_k} + \frac{\partial M_{ik}(\bm{q})}{\partial q_j} - \frac{\partial M_{kj}(\bm{q})}{\partial q_i} \right), \quad \bm{C}(\bm{q},\dot{\bm{q}})\dot{\bm{q}} = \sum_{j=1}^n \sum_{k=1}^n c_{ijk}(\bm{q})\dot{q}_j\dot{q}_k.
			\label{eq:christoffel_classical}
		\end{equation}
		For an $n=6$ DOF serial manipulator, explicitly forming all $n^3 = 216$ partial derivatives of trigonometric inertia entries induces $O(n^4)$ symbolic graph bloat, generating $14,936$ scalar operations for the Coriolis term alone (Table~\ref{tab:table3_opcodes}). We bypass the construction of the rank-3 Christoffel tensor entirely by reformulating the Coriolis and centrifugal bias vector $\mathbf{c}_{\text{bias}}(\bm{q},\dot{\bm{q}}) \equiv \bm{C}(\bm{q},\dot{\bm{q}})\dot{\bm{q}}$ directly from the Euler--Lagrange time-derivative of generalized momentum $\bm{p}(\bm{q},\dot{\bm{q}}) = \bm{M}(\bm{q})\dot{\bm{q}}$:
		\begin{equation}
			\mathbf{c}_{\text{bias}}(\bm{q}, \dot{\bm{q}}) = \frac{d}{dt}\left(\bm{M}(\bm{q})\dot{\bm{q}}\right)\Big|_{\ddot{\bm{q}}=\bm{0}} - \frac{1}{2}\nabla_{\bm{q}}\left(\dot{\bm{q}}^T \bm{M}(\bm{q})\dot{\bm{q}}\right) = \operatorname{jtimes}\left(\bm{M}(\bm{q})\dot{\bm{q}},\, \bm{q},\, \dot{\bm{q}}\right) - \frac{1}{2}\nabla_{\bm{q}}\left(\dot{\bm{q}}^T \bm{M}(\bm{q})\dot{\bm{q}}\right),
			\label{eq:cbias_momentum}
		\end{equation}
		where $\operatorname{jtimes}(\bm{f},\bm{q},\dot{\bm{q}}) \equiv \frac{\partial \bm{f}}{\partial \bm{q}}\dot{\bm{q}}$ is evaluated in a single forward-mode algorithmic differentiation (AD) sweep along the velocity seed $\dot{\bm{q}}$, and $\nabla_{\bm{q}}(\dot{\bm{q}}^T\bm{M}\dot{\bm{q}})$ is evaluated in a single reverse-mode AD sweep of the scalar kinetic energy. As proven in Proposition~\ref{prop:christoffel_equiv} and Theorem~\ref{thm:complexity}, this identity is algebraically exact, reduces asymptotic complexity from $O(n^4)$ to $O(n^2)$, compresses the Coriolis instruction graph by \textbf{63.2\%} (from 14,936 to 5,495 opcodes), and reduces the total forward dynamics graph by \textbf{55.4\%} (from 15,814 to 7,041 opcodes) while agreeing with Eq.~\eqref{eq:christoffel_classical} to $4.16 \times 10^{-17}$~N$\cdot$m.
		\item \textbf{Inversion-Free Symbolic Cholesky Factorization for Forward Dynamics:} Evaluating forward dynamics requires solving the linear system $\bm{M}(\bm{q})\ddot{\bm{q}} = \bm{\tau} - \mathbf{c}_{\text{bias}}(\bm{q},\dot{\bm{q}}) - \bm{G}(\bm{q})$. Forming the explicit symbolic inverse $\bm{M}(\bm{q})^{-1}$ via adjugate Determinants or Gauss--Jordan elimination introduces severe expression swell and division-by-pivot singularities. Exploiting the strict symmetric positive-definiteness (SPD) of $\bm{M}(\bm{q})$ (Proposition~\ref{prop:cholesky}), our engine constructs an exact pivot-free symbolic Cholesky factorization $\bm{M}(\bm{q}) = \bm{R}(\bm{q})^T \bm{R}(\bm{q})$ and resolves $\ddot{\bm{q}}$ via two sequential triangular substitutions ($\bm{R}^T\bm{y} = \bm{b}$, $\bm{R}\ddot{\bm{q}} = \bm{y}$). This reduces single-step forward dynamics latency on the UR16e from $151.5~\mu$s to \textbf{$78.7~\mu$s}---a \textbf{$1.92\times$ speedup}.
		\item \textbf{Parameterized 3D Gravitational Field ($\bm{g} \in \mathbb{R}^3$):} By formulating the potential energy gradient with respect to a symbolic 3D gravity vector $\bm{g} = [g_x, g_y, g_z]^T \in \mathbb{R}^3$, the compiled analytical functions adapt instantaneously at runtime to arbitrary base mounting tilts (wall, ceiling, inclined rail) and extraterrestrial gravitational fields without re-running URDF parsing or symbolic compilation.
	\end{enumerate}
	
	\subsection*{Tri-Paradigm Trade-Off Analysis: Inspectability vs.\ Computational Throughput}
	
	To quantify the operational trade-offs across the three architectural tiers, systematic benchmarks were executed on an AMD Ryzen 7 5800H processor (8 cores, 3.2~GHz, 64-bit Windows 11). Table~\ref{tab:table1_tradeoffs} summarizes the core mathematical lines of code (LOC), model derivation and compilation times, single-step inverse dynamics (ID) and forward dynamics (FD) latencies, software licensing requirements, and primary application domains. Table~\ref{tab:table3_opcodes} provides a granular instruction-level breakdown of the symbolic computational graph on the 6-DOF UR16e manipulator.
	
