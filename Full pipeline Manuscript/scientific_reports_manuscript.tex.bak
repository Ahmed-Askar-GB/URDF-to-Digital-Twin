			\midrule
			\textbf{Tier 1: \texttt{MATLAB-Sym}} & 420 & $6.42 \pm 0.35$ & $195.0 \pm 12.4$ & $310.0 \pm 18.0$ & Proprietary (MathWorks) & Glass-box algebraic inspection, robotics pedagogy, closed-form Lyapunov stability proofs. \\
			\textbf{Tier 2: \texttt{MATLAB-CasADi}} & 680 & $0.22 \pm 0.02$ & $110.0 \pm 8.2$ & $165.0 \pm 10.5$ & Commercial + LGPL & Industrial Model-Based Design (Simscape/Simulink), Hardware-in-the-Loop (HIL) deployment. \\
			\textbf{Tier 3: \texttt{Python-MuJoCo}} & 750 & $0.09 \pm 0.01$ & $149.0 \pm 4.2$ & $78.7 \pm 2.8$ & Permissive Open-Source & Real-time nonlinear control ($6.71$~kHz ID, $12.7$~kHz FD), NMPC synthesis, cloud digital twins. \\
			\bottomrule
		\end{tabularx}
	\end{table*}
	
	\begin{table*}[!t]
		\caption{\textbf{Derivation-Phase Symbolic Graph Profiling and Instruction Breakdown on the UR16e 6-DOF Manipulator.}}
		\label{tab:table3_opcodes}
		\centering
		\small
		\begin{tabularx}{\textwidth}{p{2.6cm}p{3.8cm}ccc>{\raggedright\arraybackslash}X}
			\toprule
			\textbf{Dynamic Term} & \textbf{Mathematical Formulation} & \textbf{Complexity} & \textbf{Baseline Op.} & \textbf{Proposed Op.} & \textbf{Symbolic Graph Impact} \\
			\midrule
			Mass Matrix $\bm{M}(\bm{q})$ & $\sum_{i=1}^n (m_i \bm{J}_{v,i}^T \bm{J}_{v,i} + \bm{J}_{\omega,i}^T \bm{I}_i^0 \bm{J}_{\omega,i})$ & $O(n^2)$ & 2,190 & 2,190 & Kinetic metric tensor ($6 \times 6$ strictly SPD). \\
			Gravity Vector $\bm{G}(\bm{q})$ & $-\sum_{i=1}^n \bm{J}_{v,i}^T m_i \bm{g}$ & $O(n)$ & 334 & 334 & Fully parameterized 3D vector $\bm{g} \in \mathbb{R}^3$. \\
			Coriolis Bias $\mathbf{c}_{\text{bias}}(\bm{q},\dot{\bm{q}})$ & $\operatorname{jtimes}(\bm{M}\dot{\bm{q}}, \bm{q}, \dot{\bm{q}}) - \frac{1}{2}\nabla_{\bm{q}}(\dot{\bm{q}}^T\bm{M}\dot{\bm{q}})$ & $O(n^2)$ vs.\ $O(n^4)$ & 14,936 & 5,495 & \textbf{-63.2\% opcodes} (replaces 216 partial derivatives with 2 AD sweeps). \\
			Inverse Dynamics $\bm{\tau}$ & $\bm{M}(\bm{q})\ddot{\bm{q}} + \mathbf{c}_{\text{bias}}(\bm{q},\dot{\bm{q}}) + \bm{G}(\bm{q})$ & $O(n^2)$ & 17,460 & 8,019 & \textbf{-54.1\% opcodes} ($149.0~\mu$s latency, $6.71$~kHz throughput). \\
			Forward Dynamics $\ddot{\bm{q}}$ & $\bm{R}^T \bm{y} = \bm{\tau} - \mathbf{c}_{\text{bias}} - \bm{G}, \; \bm{R}\ddot{\bm{q}} = \bm{y}$ & $O(n^3)$ Cholesky & 15,814 & 7,041 & \textbf{-55.4\% opcodes} ($1.92\times$ speedup: $78.7~\mu$s vs.\ $151.5~\mu$s; inversion-free). \\
			\bottomrule
		\end{tabularx}
	\end{table*}
	
	As shown in Table~\ref{tab:table1_tradeoffs}, Tier 1 (\texttt{MATLAB-Sym}) provides complete symbolic visibility into every intermediate matrix entry. For example, inspecting $M_{11}(\bm{q})$ yields an explicit trigonometric polynomial spanning 3,420 characters, allowing researchers and students to directly trace how shoulder and elbow postures modulate the effective inertia reflected at the base actuator. While naive symbolic substitution via \texttt{subs()} requires $18.4$--$25.0$~ms per evaluation \cite{ihab2026urdf2dt}, compiling the symbolic expressions into vectorized MATLAB function handles via \texttt{matlabFunction} reduces single-step inverse dynamics evaluation to $195.0~\mu$s ($\approx 5.1$~kHz).
	
	Tier 2 (\texttt{MATLAB-CasADi}) accelerates model derivation by $29.2\times$ ($0.22$~s vs.\ $6.42$~s) by constructing directed acyclic AD graphs rather than symbolic expression trees, while programmatically generating an instrumented Simscape Multibody digital twin (\texttt{.slx}) for multi-domain physical co-simulation.
	
	Tier 3 (\texttt{Python-MuJoCo}) achieves the fastest model compilation ($0.09$~s) and forward dynamics evaluation ($78.7~\mu$s, corresponding to $12.7$~kHz throughput). Furthermore, leveraging CasADi's symbolic map-accumulation operator (\texttt{mapaccum}) over a 4th-order Runge--Kutta (RK4) integrator, Tier 3 simulates a 5,000-step dynamic rollout ($5.0$~s horizon at $dt = 1$~ms) in just \textbf{$0.4035$~s ($12.4\times$ faster than real-time)} under terrestrial gravity, narrowing the single-core CPU runtime gap between a fully differentiable white-box CasADi graph and native-C MuJoCo down to \textbf{$4.8\times$}.
	
	\subsection*{Multi-Robot Morphological Diversity and Empirical Benchmark Analysis}
	
	To demonstrate that our framework generalizes across arbitrary serial manipulator topologies without robot-specific manual tuning, hardcoded kinematic tables, or empirical trial-and-error, we executed the complete pipeline and autonomous 5-stage verification suite across four benchmark industrial manipulators spanning diverse kinematic arrangements, payload-to-weight ratios, and mechanical scales:
	\begin{enumerate}
		\item \textbf{Universal Robots UR5 (Medium-Reach Collaborative):} A 6-DOF anthropomorphic cobot ($18.40$~kg total mass, $16.99$~kg active arm mass, $0.850$~m reach, $5.0$~kg payload) featuring parallel shoulder and elbow axes ($\hat{\bm{z}}_1 \parallel \hat{\bm{z}}_2 \parallel \hat{\bm{z}}_3$, Regime 3) and a non-spherical orthogonal wrist ($d_4 = 0.1091$~m, $d_5 = 0.0946$~m, $a_6 = 0.0823$~m) \cite{ihab2026urdf2dt, asr2026calibration}.
		\item \textbf{Universal Robots UR16e (Heavy-Payload Collaborative):} A high-capacity 6-DOF cobot ($33.10$~kg total mass, $27.26$~kg active arm mass, $0.900$~m reach) with an extreme $16.0$~kg payload-to-weight ratio. The large proximal castings ($m_2 = 10.45$~kg, $m_3 = 4.32$~kg) produce aggressive nonlinear centrifugal and Coriolis dynamic cross-coupling during high-speed maneuvers.
		\item \textbf{ABB IRB 120 (Compact Articulated Spherical Wrist):} A high-speed 6-DOF compact industrial arm ($25.00$~kg total mass, $11.93$~kg active arm mass, $0.580$~m reach, $3.0$~kg payload). The manipulator features a spatial shoulder offset ($a_3 = 0.070$~m), producing a non-intersecting skew axis pair (Regime 1), followed by an intersecting 3-axis spherical wrist ($a_4 = a_5 = a_6 = 0$, Regime 2) where the wrist axes intersect at a singular intersection point.
		\item \textbf{Unimation Puma 560 (Classical Spatial Offset Benchmark):} A classical 6-DOF industrial manipulator ($54.20$~kg total mass, $23.50$~kg active arm mass, $0.864$~m reach, $2.5$~kg payload) exhibiting a spatial shoulder offset ($d_3 = 0.1501$~m, $a_3 = -0.0203$~m) and historical literature CAD inertia models requiring spectral physical realizability projection.
	\end{enumerate}
	
	Figure~\ref{fig:fig5_robot_gallery} provides a visual gallery of the four tested platforms with framed architectural summary cards, and Table~\ref{tab:table4_morphology} details their extracted kinematic, inertial, topological, and computational characteristics. Quantitative verification results across the 5-stage verification protocol are summarized in Table~\ref{tab:table2_verification}.
	
